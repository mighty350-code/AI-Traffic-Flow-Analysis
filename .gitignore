# Local inputs, model weights and generated results
# Anchored to the repository root so that curated sub-project payloads
# (e.g. ti_trajectory/data/) are not swept up by these rules.
/data/
/models/
/outputs/
/logs/
/backups/
*.pt
*.pth
*.onnx
*.mp4
*.avi
*.mov
*.mkv
*.zip

# Download FLUID separately; do not vendor its repository here
third_party/FLUID/

# Python and local tooling
__pycache__/
*.py[cod]
.venv/
venv/
.cache/
.ultralytics/
.pytest_cache/
.idea/
.vscode/
.env
.env.*
